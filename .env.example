# Copy this file to .env and add your keys. Every key is optional:
# without keys, Jaku uses an offline quiz planner and the browser's
# built-in speech recognition.

# Quiz planning (either one). Anthropic is used first if both are set.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5

# OpenAI: Whisper transcription (and quiz planning if no Anthropic key)
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_TRANSCRIBE_MODEL=whisper-1
